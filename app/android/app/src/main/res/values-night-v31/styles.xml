<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash screen. The mark is static and the
         animation time is 0: the system removes the splash on Flutter's first
         frame, and the Flutter intro starts from the same pixels. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#121113</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
